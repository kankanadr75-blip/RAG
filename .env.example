# ===========================================================================
# TEMPLATE - copy to .env and fill in your key(s).
#
#   Windows PowerShell :  Copy-Item .env.example .env
#   Git Bash / macOS   :  cp .env.example .env
#
# This file is tracked by git and MUST stay secret-free. Never paste a real
# key here.
#
# The app runs without any LLM key: it falls back to extractive mode (NFR-5),
# quoting the retrieved source chunk verbatim instead of paraphrasing it.
# Retrieval, guardrails, citations and the UI all work offline either way.
# ===========================================================================


# --- GROQ  (recommended - free tier, fast) -------------------------------
# Key: https://console.groq.com/keys  ->  API Keys  ->  Create Key
#
# Note: Groq serves a per-account model subset. List what YOUR account can
# actually call with:
#     curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $KEY"
# A model that works for one person returns 404 for another.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Tried, in order, when GROQ_MODEL cannot answer - most often because its
# 200k tokens/day budget (which Groq applies PER MODEL) is spent. Different
# models have separate budgets, so this is what keeps the chatbot answering
# instead of degrading to a verbatim quote. Comma-separated; "" disables.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b


# --- OpenAI  (optional alternative) ---------------------------------------
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# --- Google Gemini  (optional alternative) ---------------------------------
# Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# --- Hugging Face  (optional) ----------------------------------------------
# Only needed to raise the public download rate limit for the embedding model
# sentence-transformers/all-MiniLM-L6-v2. Not required - it downloads fine
# anonymously.
# Token: https://huggingface.co/settings/tokens
HF_TOKEN=