# --- Secrets: NEVER commit (NFR-2) ---
.env
.env.*
!.env.example

# Streamlit Community Cloud secrets. The app itself never reads this file -
# the key is pasted into the Cloud's Secrets panel, which injects it as an
# environment variable - but a local secrets.toml is the conventional way to
# develop against the same config, so it must never be committable.
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Vector DB ------------------------------------------------------------
# data/chroma/chroma.sqlite3 IS committed, deliberately. It holds the 130 chunk
# vectors in portable SQLite (~5 MB) so a fresh clone starts instantly instead
# of downloading the embedding model and re-embedding on first run. That matters
# most on Streamlit Community Cloud, which has no build command.
#
# The rest of data/chroma/ is NOT: those are Chroma's HNSW index binaries, a
# rebuildable cache that Chroma regenerates from the SQLite vectors on first
# query. Committing them would add machine-specific binaries for no benefit.
data/chroma/*
!data/chroma/chroma.sqlite3

# --- Resume cache for scripts/capture_sample_qa.py ---
# Holds already-captured answers so a rate-limited capture can resume instead
# of re-spending tokens. The committed artefact is deliverables/sample_qa.md.
data/sample_qa_cache.json

# NOTE: data/raw/ and data/chunks.txt are intentionally NOT ignored.
# They are the audit trail that lets a reviewer inspect the corpus
# without re-running ingestion. Keep them tracked.
